{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/register", "destination": "/api" },
    { "source": "/login", "destination": "/api" },
    { "source": "/me", "destination": "/api" },
    { "source": "/debug/:path*", "destination": "/api" },
    { "source": "/tasks/:path*", "destination": "/api" },
    { "source": "/tasks", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!health|register|login|me|debug|tasks|api).*)", "destination": "/index.html" }
  ]
}
