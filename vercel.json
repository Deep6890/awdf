{
  "version": 2,
  "buildCommand": "cd task-manager/client && npm install && npm run build",
  "outputDirectory": "task-manager/client/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/register", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/api/index.js" },
    { "source": "/me", "destination": "/api/index.js" },
    { "source": "/debug/cache", "destination": "/api/index.js" },
    { "source": "/tasks/(.*)", "destination": "/api/index.js" },
    { "source": "/tasks", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/|tasks|register|login|me|health|debug).*)", "destination": "/index.html" }
  ]
}
